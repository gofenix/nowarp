#!/usr/bin/env bash
#
# Build and optionally publish a signed, notarized Nowarp macOS DMG without
# modifying the upstream Warp bundle script. This uses the OSS channel build as
# an intermediate artifact, then rewrites bundle metadata, signs, notarizes, and
# creates Nowarp.dmg.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "$REPO_ROOT"

APP_NAME="${NOWARP_APP_NAME:-Nowarp}"
BUNDLE_ID="${NOWARP_BUNDLE_ID:-com.gofenix.Nowarp}"
URL_SCHEME="${NOWARP_URL_SCHEME:-nowarp}"
DMG_NAME="${NOWARP_DMG_NAME:-Nowarp.dmg}"
DMG_VOLUME_NAME="${NOWARP_DMG_VOLUME_NAME:-Nowarp}"
SIGNING_IDENTITY="${NOWARP_SIGNING_IDENTITY:-}"
APPLE_TEAM_ID="${NOWARP_APPLE_TEAM_ID:-}"
NOTARY_PROFILE="${NOWARP_NOTARY_PROFILE:-}"
NOTARIZATION_APPLE_ID="${NOWARP_NOTARIZATION_APPLE_ID:-}"
NOTARIZATION_PASSWORD="${NOWARP_NOTARIZATION_PASSWORD:-}"
APP_GROUP="${NOWARP_APP_GROUP:-}"
SOURCE_APP_NAME="WarpOss"

CHECK_ONLY=false
DEBUG=false
OPEN_AFTER_BUNDLE=false
UNSIGNED=false
PUBLISH_RELEASE=false
DRAFT_RELEASE=false
PRERELEASE=false
RELEASE_TAG="${NOWARP_RELEASE_TAG:-}"
RELEASE_TITLE="${NOWARP_RELEASE_TITLE:-}"
RELEASE_NOTES="${NOWARP_RELEASE_NOTES:-Nowarp macOS release.}"
UPSTREAM_ARGS=()
UPSTREAM_ARCH_MODE_SET=false

while (($#)); do
  case "$1" in
    --check-only)
      CHECK_ONLY=true
      UPSTREAM_ARGS+=("$1")
      shift
      ;;
    --debug)
      DEBUG=true
      UPSTREAM_ARGS+=("$1")
      shift
      ;;
    -o|--open)
      OPEN_AFTER_BUNDLE=true
      shift
      ;;
    --unsigned)
      UNSIGNED=true
      shift
      ;;
    --publish-release)
      PUBLISH_RELEASE=true
      shift
      ;;
    --draft)
      DRAFT_RELEASE=true
      shift
      ;;
    --prerelease)
      PRERELEASE=true
      shift
      ;;
    --release-tag)
      if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
        RELEASE_TAG="$2"
        UPSTREAM_ARGS+=("$1" "$2")
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --nouniversal)
      UPSTREAM_ARCH_MODE_SET=true
      UPSTREAM_ARGS+=("$1")
      shift
      ;;
    --arch)
      if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
        UPSTREAM_ARCH_MODE_SET=true
        UPSTREAM_ARGS+=("$1" "$2")
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --signing-identity)
      if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
        SIGNING_IDENTITY="$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --apple-team-id)
      if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
        APPLE_TEAM_ID="$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --notary-profile)
      if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
        NOTARY_PROFILE="$2"
        shift 2
      else
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --channel|-c|--artifact|--read-passwords-from-env|--selfsign)
      echo "$1 is not supported by script/bundle_nowarp; this script owns the Nowarp signing and release path." >&2
      exit 1
      ;;
    --nosign)
      echo "Use --unsigned only for local test builds. The default path signs and notarizes the DMG." >&2
      exit 1
      ;;
    --app-name|--bundle-id|--url-scheme|--dmg-name|--dmg-volume-name)
      echo "$1 belongs to the upstream bundle extension path and is intentionally not supported here." >&2
      exit 1
      ;;
    *)
      UPSTREAM_ARGS+=("$1")
      shift
      ;;
  esac
done

UPSTREAM_BUNDLE_ARGS=("${UPSTREAM_ARGS[@]}")
if [[ "$UPSTREAM_ARCH_MODE_SET" != true ]]; then
  UPSTREAM_BUNDLE_ARGS+=(--nouniversal)
fi

if [[ "$CHECK_ONLY" == true ]]; then
  exec ./script/bundle --channel oss "${UPSTREAM_BUNDLE_ARGS[@]}"
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "Nowarp DMG packaging must run on macOS." >&2
  exit 1
fi
if [[ "$PUBLISH_RELEASE" == true && "$UNSIGNED" == true ]]; then
  echo "Refusing to publish an unsigned DMG." >&2
  exit 1
fi
if [[ "$PUBLISH_RELEASE" == true && "$DEBUG" == true ]]; then
  echo "Refusing to publish a debug DMG." >&2
  exit 1
fi

if ! command -v create-dmg >/dev/null; then
  echo "create-dmg is required to build $DMG_NAME. Install it with: brew install create-dmg" >&2
  exit 1
fi
if [[ "$UNSIGNED" != true ]]; then
  if ! command -v xcrun >/dev/null; then
    echo "xcrun is required for notarization." >&2
    exit 1
  fi

  if [[ -z "$SIGNING_IDENTITY" ]]; then
    SIGNING_IDENTITY="$(security find-identity -p codesigning -v | awk -F '"' '/Developer ID Application/ { print $2; exit }')"
  fi
  if [[ -z "$SIGNING_IDENTITY" ]]; then
    echo "No Developer ID Application signing identity found. Set NOWARP_SIGNING_IDENTITY or pass --signing-identity." >&2
    exit 1
  fi

  if [[ -z "$NOTARY_PROFILE" && ( -z "$NOTARIZATION_APPLE_ID" || -z "$NOTARIZATION_PASSWORD" || -z "$APPLE_TEAM_ID" ) ]]; then
    echo "Notarization credentials are required. Set NOWARP_NOTARY_PROFILE or NOWARP_NOTARIZATION_APPLE_ID/NOWARP_NOTARIZATION_PASSWORD/NOWARP_APPLE_TEAM_ID." >&2
    exit 1
  fi
fi
if [[ "$PUBLISH_RELEASE" == true && -z "$RELEASE_TAG" ]]; then
  RELEASE_TAG="$(git describe --tags --exact-match 2>/dev/null || true)"
  if [[ -z "$RELEASE_TAG" ]]; then
    echo "Publishing requires --release-tag, or run from a tagged commit." >&2
    exit 1
  fi
fi
if [[ "$PUBLISH_RELEASE" == true && -z "$RELEASE_TITLE" ]]; then
  RELEASE_TITLE="$APP_NAME $RELEASE_TAG"
fi
if [[ "$PUBLISH_RELEASE" == true ]] && ! command -v gh >/dev/null; then
  echo "gh is required to publish the GitHub Release." >&2
  exit 1
fi

if [[ "$DEBUG" == true ]]; then
  OUT_DIR="target/debug/bundle/osx"
  TARGET_PROFILE_DIR="debug"
else
  OUT_DIR="target/release-lto/bundle/osx"
  TARGET_PROFILE_DIR="release-lto"
fi

SOURCE_APP="$OUT_DIR/$SOURCE_APP_NAME.app"
TARGET_APP="$OUT_DIR/$APP_NAME.app"
DMG_PATH="$OUT_DIR/$DMG_NAME"
STAGE_DIR="$OUT_DIR/nowarp-dmg"
ENTITLEMENTS_PATH="$OUT_DIR/nowarp-entitlements.plist"

delete_rpath_if_present() {
  local binary_path="$1"
  local rpath="$2"

  if [[ -f "$binary_path" ]] && otool -l "$binary_path" | grep -Fq "path $rpath "; then
    install_name_tool -delete_rpath "$rpath" "$binary_path"
  fi
}

prepare_upstream_bundle_cache() {
  local framework_rpath="@executable_path/../Frameworks"

  delete_rpath_if_present "target/aarch64-apple-darwin/$TARGET_PROFILE_DIR/warp-oss" "$framework_rpath"
  delete_rpath_if_present "target/x86_64-apple-darwin/$TARGET_PROFILE_DIR/warp-oss" "$framework_rpath"
  rm -rf \
    "target/aarch64-apple-darwin/$TARGET_PROFILE_DIR/bundle/osx/$SOURCE_APP_NAME.app" \
    "target/x86_64-apple-darwin/$TARGET_PROFILE_DIR/bundle/osx/$SOURCE_APP_NAME.app" \
    "$SOURCE_APP"
}

echo "Building base OSS bundle as an intermediate artifact..."
prepare_upstream_bundle_cache
./script/bundle --channel oss --nosign "${UPSTREAM_BUNDLE_ARGS[@]}"

if [[ ! -d "$SOURCE_APP" ]]; then
  echo "Expected source app at $SOURCE_APP, but it was not created." >&2
  exit 1
fi

echo "Preparing $TARGET_APP..."
rm -rf "$TARGET_APP" "$STAGE_DIR" "$DMG_PATH"
mkdir -p "$STAGE_DIR"
ditto "$SOURCE_APP" "$TARGET_APP"

plist_set_string() {
  local plist_path="$1"
  local key="$2"
  local value="$3"

  if plutil -extract "$key" raw -o - "$plist_path" >/dev/null 2>&1; then
    plutil -replace "$key" -string "$value" "$plist_path"
  else
    plutil -insert "$key" -string "$value" "$plist_path"
  fi
}

plist_set_xml() {
  local plist_path="$1"
  local key="$2"
  local value="$3"

  if plutil -extract "$key" raw -o - "$plist_path" >/dev/null 2>&1; then
    plutil -replace "$key" -xml "$value" "$plist_path"
  else
    plutil -insert "$key" -xml "$value" "$plist_path"
  fi
}

APP_PLIST="$TARGET_APP/Contents/Info.plist"
PLUGIN_PLIST="$TARGET_APP/Contents/PlugIns/WarpDockTilePlugin.docktileplugin/Contents/Info.plist"

echo "Rewriting bundle metadata..."
plist_set_string "$APP_PLIST" CFBundleIdentifier "$BUNDLE_ID"
plist_set_string "$APP_PLIST" CFBundleName "$APP_NAME"
plist_set_string "$APP_PLIST" CFBundleDisplayName "$APP_NAME"
plist_set_xml "$APP_PLIST" CFBundleURLTypes "<array><dict><key>CFBundleURLName</key><string>Custom App</string><key>CFBundleURLSchemes</key><array><string>$URL_SCHEME</string></array></dict></array>"
plist_set_xml "$APP_PLIST" SMAuthorizedClients "<array><string>$BUNDLE_ID</string></array>"
plist_set_xml "$APP_PLIST" NSServices "
<array>
  <dict>
    <key>NSMenuItem</key>
    <dict>
      <key>default</key>
      <string>New $APP_NAME Tab Here</string>
    </dict>
    <key>NSMessage</key>
    <string>openTab</string>
    <key>NSRequiredContext</key>
    <dict>
      <key>NSTextContent</key>
      <string>FilePath</string>
    </dict>
    <key>NSSendTypes</key>
    <array>
      <string>NSFilenamesPboardType</string>
      <string>public.plain-text</string>
    </array>
  </dict>
  <dict>
    <key>NSMenuItem</key>
    <dict>
      <key>default</key>
      <string>New $APP_NAME Window Here</string>
    </dict>
    <key>NSMessage</key>
    <string>openWindow</string>
    <key>NSRequiredContext</key>
    <dict>
      <key>NSTextContent</key>
      <string>FilePath</string>
    </dict>
    <key>NSSendTypes</key>
    <array>
      <string>NSFilenamesPboardType</string>
      <string>public.plain-text</string>
    </array>
  </dict>
</array>"

if [[ -f "$PLUGIN_PLIST" ]]; then
  plist_set_string "$PLUGIN_PLIST" MainAppBundleIdentifier "$BUNDLE_ID"
fi

write_entitlements() {
  local entitlements_path="$1"
  local app_group="$2"

  cat > "$entitlements_path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
EOF

  if [[ -n "$app_group" ]]; then
    cat >> "$entitlements_path" <<EOF
  <key>com.apple.security.application-groups</key>
  <array>
    <string>$app_group</string>
  </array>
EOF
  fi

  cat >> "$entitlements_path" <<EOF
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.personal-information.addressbook</key>
  <true/>
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>
  <key>com.apple.security.personal-information.photos-library</key>
  <true/>
</dict>
</plist>
EOF
}

notary_submit() {
  local artifact="$1"

  if [[ -n "$NOTARY_PROFILE" ]]; then
    xcrun notarytool submit "$artifact" --keychain-profile "$NOTARY_PROFILE" --wait
  else
    xcrun notarytool submit "$artifact" \
      --apple-id "$NOTARIZATION_APPLE_ID" \
      --password "$NOTARIZATION_PASSWORD" \
      --team-id "$APPLE_TEAM_ID" \
      --wait
  fi
}

if [[ "$UNSIGNED" != true ]]; then
  echo "Signing $TARGET_APP with $SIGNING_IDENTITY..."
  write_entitlements "$ENTITLEMENTS_PATH" "$APP_GROUP"
  codesign --force --deep --options runtime --timestamp --sign "$SIGNING_IDENTITY" --entitlements "$ENTITLEMENTS_PATH" "$TARGET_APP"
  codesign --verify --deep --strict --verbose=2 "$TARGET_APP"
fi

ditto "$TARGET_APP" "$STAGE_DIR/$APP_NAME.app"

echo "Creating $DMG_PATH..."
hdiutil info | awk -v volume="/Volumes/$DMG_VOLUME_NAME" '$0 ~ volume { print $1 }' | while read -r disk; do
  hdiutil detach "$disk" -force || true
done

create-dmg \
  --volname "$DMG_VOLUME_NAME" \
  --no-internet-enable \
  --background app/assets/resources/mac/warp_install_image.png \
  --icon-size 128 \
  --window-size 700 500 \
  --format UDZO \
  --app-drop-link 550 250 \
  --icon "$APP_NAME.app" 150 250 \
  --filesystem APFS \
  "$DMG_PATH" \
  "$STAGE_DIR"

if [[ "$UNSIGNED" != true ]]; then
  echo "Signing $DMG_PATH..."
  codesign --force --timestamp --sign "$SIGNING_IDENTITY" "$DMG_PATH"

  echo "Submitting $DMG_PATH for notarization..."
  notary_submit "$DMG_PATH"

  echo "Stapling notarization ticket..."
  xcrun stapler staple "$DMG_PATH"
  xcrun stapler validate "$DMG_PATH"
  spctl -a -t open --context context:primary-signature -vv "$DMG_PATH"
fi

if [[ "$PUBLISH_RELEASE" == true ]]; then
  echo "Publishing $DMG_PATH to GitHub Release $RELEASE_TAG..."
  if gh release view "$RELEASE_TAG" >/dev/null 2>&1; then
    gh release upload "$RELEASE_TAG" "$DMG_PATH" --clobber
  else
    gh_args=(release create "$RELEASE_TAG" "$DMG_PATH" --target "$(git rev-parse HEAD)" --title "$RELEASE_TITLE" --notes "$RELEASE_NOTES")
    if [[ "$DRAFT_RELEASE" == true ]]; then
      gh_args+=(--draft)
    fi
    if [[ "$PRERELEASE" == true ]]; then
      gh_args+=(--prerelease)
    fi
    gh "${gh_args[@]}"
  fi
fi

if [[ "$OPEN_AFTER_BUNDLE" == true ]]; then
  open "$OUT_DIR"
fi

echo "Created $DMG_PATH"
